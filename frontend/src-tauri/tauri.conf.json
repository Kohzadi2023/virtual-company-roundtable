{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual Company",
  "version": "1.9.0",
  "identifier": "com.kohzadi.virtualcompany",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Virtual Company",
        "width": 1500,
        "height": 950,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Virtual Company",
    "category": "Business",
    "shortDescription": "Multi-specialist virtual company collaboration workspace",
    "longDescription": "Virtual Company is a local-first desktop workspace for structured multi-specialist discussions, room management, projects, decisions, action items, and meeting minutes.",
    "externalBin": ["binaries/virtual-company-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
